#!/usr/bin/env bash
set -euo pipefail

VERSION="0.1.0"

resolve_script_path() {
  local source_path="${BASH_SOURCE[0]}"
  local dir=""
  while [[ -h "$source_path" ]]; do
    dir="$(cd -P "$(dirname "$source_path")" && pwd)"
    source_path="$(readlink "$source_path")"
    [[ "$source_path" != /* ]] && source_path="${dir}/${source_path}"
  done
  dir="$(cd -P "$(dirname "$source_path")" && pwd)"
  printf "%s/%s" "$dir" "$(basename "$source_path")"
}

SCRIPT_PATH="$(resolve_script_path)"
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
DATA_DIR="${HOME}/.itte"
PROFILE_FILE="${DATA_DIR}/profile.json"
SUMMARIES_FILE="${DATA_DIR}/summaries.jsonl"
TOPICS_FILE="${DATA_DIR}/daily_topics.json"
SESSION_FILE="${DATA_DIR}/current_session.json"
RUN_LOG_FILE="${DATA_DIR}/run_logs.jsonl"
SETTINGS_FILE="${DATA_DIR}/settings.json"

HISTORY_JSON='[]'
LAST_SUMMARY_JSON=""
CURRENT_SCENE_HINT="General conversation"
MODEL_REPLY=""
MODEL_REPLY_STREAMED=0
READ_INPUT_LINE_VALUE=""
INPUT_HISTORY_POS=0
INPUT_HISTORY_STASH=""
MAX_INPUT_HISTORY=200
declare -a INPUT_HISTORY=()
PREVIEW_ROWS=1

SESSION_ID=""
SESSION_STARTED_AT=""

USER_TURNS=0
ASSISTANT_TURNS=0
TOTAL_USER_CHARS=0
OPTIMIZE_COUNT=0
HELP_COUNT=0
DAILY_COUNT=0

ITTE_API_BASE="${ITTE_API_BASE:-}"
ITTE_API_KEY="${ITTE_API_KEY:-}"
ITTE_MODEL="${ITTE_MODEL:-}"
ITTE_TEMPERATURE="${ITTE_TEMPERATURE:-1}"
ITTE_STREAM="${ITTE_STREAM:-1}"
ITTE_COLOR_COMMANDS="${ITTE_COLOR_COMMANDS:-1}"
ITTE_SHOW_THINKING="${ITTE_SHOW_THINKING:-1}"
ITTE_COMMAND_COLOR="${ITTE_COMMAND_COLOR:-}"
ITTE_TOPIC_COLOR="${ITTE_TOPIC_COLOR:-}"
ITTE_BILINGUAL_ASSIST="${ITTE_BILINGUAL_ASSIST:-}"
ITTE_WEB_MODE="${ITTE_WEB_MODE:-0}"
API_URL=""

# Keep module load order stable; later modules rely on helpers from earlier ones.
source "${SCRIPT_DIR}/lib/core.sh"
source "${SCRIPT_DIR}/lib/config.sh"
source "${SCRIPT_DIR}/lib/storage.sh"
source "${SCRIPT_DIR}/lib/api.sh"
source "${SCRIPT_DIR}/lib/render.sh"
source "${SCRIPT_DIR}/lib/settings_ui.sh"
source "${SCRIPT_DIR}/lib/commands.sh"

main() {
  case "${1:-}" in
    --help|-h)
      print_usage
      exit 0
      ;;
    --version|-v)
      echo "itte ${VERSION}"
      exit 0
      ;;
    --install)
      install_to_user_bin
      exit 0
      ;;
    --uninstall)
      uninstall_from_user_bin
      exit 0
      ;;
    "")
      ;;
    *)
      echo "Unknown flag: $1"
      print_usage
      exit 1
      ;;
  esac

  require_bin "curl"
  require_bin "jq"

  load_dotenv_if_exists
  ensure_data_files
  load_settings
  validate_env
  init_session
  write_current_session
  print_welcome
  echo
  main_loop
}

main "$@"
